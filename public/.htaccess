# Production: redirect HTTP before serving forms or receiving credentials.
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Accounts use this one origin for sessions, links and request validation.
    RewriteCond %{HTTP_HOST} ^www\.somanambiti\.com$ [NC]
    RewriteRule ^ https://somanambiti.com%{REQUEST_URI} [R=301,L]
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>
Options -Indexes
DirectoryIndex index.html
<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header always set Cache-Control "no-cache, must-revalidate"
        Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-src https:; media-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
    </FilesMatch>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header always set X-Frame-Options "DENY"
    Header always set Strict-Transport-Security "max-age=2592000"
    Header always set Permissions-Policy "camera=(), geolocation=(), payment=(), microphone=(self)"
    Header unset X-Powered-By
    Header always unset X-Powered-By
</IfModule>
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Course data is delivered through verified, enrollment-checked PHP endpoints.
<FilesMatch "^(course\.(js|json)|content\.(js|json))$">
    Require all denied
</FilesMatch>

# Source archives, database exports and editor copies must never be web downloads.
<FilesMatch "(?i)\.(?:sql|sqlite3?|log|ini|env|bak|backup|old|orig|swp|zip|tar|gz|lock|map)$">
    Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
    RewriteRule ^(?:private|database|tests|work|\.git)(?:/|$) - [F,L,NC]
</IfModule>
